; One Big Package — Godot project.
; Engine version pinned by tools/bootstrap-godot.*; see docs/MIGRATION.md.

config_version=5

[application]

config/name="One Big Package"
config/description="Native runtime for the PS2 Ratchet & Clank trilogy (Going Commando first)."
run/main_scene="res://scenes/OBPGame.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/branding/obp-icon.png"
config/windows_native_icon="res://assets/branding/obp-icon.ico"

[autoload]

UiBootstrap="*res://scripts/UiBootstrap.cs"

[dotnet]

project/assembly_name="OneBigPackage"

[input]

; Joypad events use Godot/SDL logical controls. Gameplay consumes these named
; actions and never depends on Nintendo-specific physical button numbers.
obp_move_left={
"deadzone": 0.0,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null), Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":-1.0,"script":null)]
}
