[physics]

; The selected retail-derived Ratchet controller advances once per native NTSC update.
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
; Sandboxes / headless CI pass --rendering-method gl_compatibility on the command line.
